# File này CHỈ để bạn ghi lại tạm các giá trị secret khi thiết lập —
# KHÔNG được Worker đọc trực tiếp (Cloudflare Workers không dùng file .env).
# Toàn bộ secret thật phải được set qua lệnh `wrangler secret put <TÊN>`,
# rồi Cloudflare mới đưa vào env khi Worker chạy.

# Lấy từ @BotFather khi tạo bot
BOT_TOKEN=

# Tự sinh 1 chuỗi ngẫu nhiên an toàn, ví dụ chạy: openssl rand -hex 32
WEBHOOK_SECRET=

# ================== CÁCH SET THẬT LÊN CLOUDFLARE ==================
# wrangler secret put BOT_TOKEN
# wrangler secret put WEBHOOK_SECRET
#
# Sau khi set xong, dùng CHÍNH giá trị WEBHOOK_SECRET này khi đăng ký
# webhook với Telegram (xem README.md mục 7):
#
# curl "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" \
#   -d "url=https://<worker-url>/webhook" \
#   -d "secret_token=<WEBHOOK_SECRET>"
